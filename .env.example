# === Acceso de Borja al editor (obligatorio) ===
# Código con el que entra Borja en /admin y secreto para firmar su sesión.
ADMIN_CODE=elige-un-codigo-para-borja
ADMIN_SECRET=genera-uno-largo-con-openssl-rand-base64-32

# === Formulario de contacto ===
# Destinatario de las consultas (queda solo en el servidor, no se muestra).
CONTACTO_TO=informa@blablaele.com

# === Pendiente para producción (guardado y subida de fotos de Borja) ===
# Sin esto, en la web publicada los cambios y las subidas del editor no persisten.
# Base de datos (Neon Postgres) y almacenamiento de imágenes (Vercel Blob):
# DATABASE_URL=postgres://...neon...
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# === Pendiente (Fase 4: anti-spam propio con Resend + Turnstile) ===
# RESEND_API_KEY=re_...
# RESEND_FROM=web@borjasatrustegui.online
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
